# Clear defaults
keybind = clear

# Restore essentials
keybind = super+q=quit
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard

# Leader (F12) — Tabs
keybind = f12>c=new_tab
keybind = f12>one=goto_tab:1
keybind = f12>two=goto_tab:2
keybind = f12>three=goto_tab:3
keybind = f12>four=goto_tab:4
keybind = f12>five=goto_tab:5
keybind = f12>six=goto_tab:6
keybind = f12>seven=goto_tab:7
keybind = f12>eight=goto_tab:8
keybind = f12>nine=toggle_command_palette

# Leader (F12) — Splits
keybind = f12>v=new_split:right
keybind = f12>s=new_split:down
keybind = f12>z=toggle_split_zoom
keybind = f12>x=close_surface

# Leader (F12) — Font size
keybind = f12>equal=increase_font_size:1
keybind = f12>minus=decrease_font_size:1

# Split navigation (Super+HJKL for Ghostty, Ctrl+HJKL stays for Neovim)
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right

# Resize mode (key table)
keybind = f12>w=activate_key_table:resize
keybind = resize/l=resize_split:left,5
keybind = resize/r=resize_split:right,5
keybind = resize/u=resize_split:up,5
keybind = resize/d=resize_split:down,5
keybind = resize/shift+l=resize_split:left,15
keybind = resize/shift+r=resize_split:right,15
keybind = resize/shift+u=resize_split:up,15
keybind = resize/shift+d=resize_split:down,15
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=ignore
